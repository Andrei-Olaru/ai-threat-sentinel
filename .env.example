# =============================================================================
# Environment variables template — copy as .env and fill in real values
# =============================================================================

# --- App ---
APP_NAME=ai-threat-sentinel
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- PostgreSQL ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev_pass@localhost:5432/threat_sentinel

# --- Redis ---
# Format: redis://HOST:PORT/DB_NUMBER (0-15)
REDIS_URL=redis://localhost:6379/0

# --- Groq API (LLM) ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_ID=llama-3.3-70b-versatile
# Alternatives: openai/gpt-oss-20b, openai/gpt-oss-120b

# --- ML Engine (Isolation Forest) ---
ML_CONTAMINATION=0.1
ML_N_ESTIMATORS=100

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
